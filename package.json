{
  "name": "graforum",
  "productName": "Graforum",
  "version": "0.1.1",
  "description": "Editor di grafo narrativo D&D",
  "private": true,
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "smoke": "electron scripts/smoke.cjs",
    "dist": "electron-vite build && electron-builder --win --publish never",
    "release": "node scripts/release.cjs",
    "icon": "electron scripts/make-icon.cjs"
  },
  "build": {
    "appId": "it.perrons.graforum",
    "productName": "Graforum",
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**/*",
      "resources/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "fileAssociations": [
      {
        "ext": "dng",
        "name": "Progetto Graforum",
        "description": "Progetto di grafo narrativo"
      }
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "Riccardo-Perrone",
        "repo": "graforum",
        "releaseType": "release"
      }
    ],
    "electronLanguages": [
      "it",
      "en-US"
    ]
  },
  "dependencies": {
    "electron-updater": "^6.8.11",
    "fflate": "^0.8.3"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@fontsource/geist-mono": "^5.3.0",
    "@fontsource/geist-sans": "^5.3.0",
    "@lezer/highlight": "^1.2.5",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@xyflow/react": "^12.12.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "codemirror": "^6.0.2",
    "dockview-react": "^8.9.0",
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "immer": "^11.1.21",
    "lucide-react": "^1.59.0",
    "marked": "^18.1.1",
    "nanoid": "^6.0.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "zod": "^4.6.7",
    "zustand": "^5.0.15"
  }
}
